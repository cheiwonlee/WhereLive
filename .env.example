# 카카오 개발자 사이트 (https://developers.kakao.com) > 앱 > 플랫폼 키
VITE_KAKAO_APP_KEY=여기에_JavaScript_키
VITE_KAKAO_REST_KEY=여기에_REST_API_키

# 공공데이터포털 (https://data.go.kr) > 마이페이지 > 인증키
VITE_DATA_GO_KR_KEY=여기에_공공데이터_인증키

# 서울 열린데이터 (https://data.seoul.go.kr)
VITE_SEOUL_DATA_KEY=여기에_서울데이터_인증키

# Supabase (https://supabase.com) - 나중에 설정
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
